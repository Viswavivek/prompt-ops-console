# ---- API ----
# Base URL of the BACKEND API layer (not n8n, not PostgreSQL).
VITE_API_BASE_URL=http://localhost:8080/api

# Request timeout in milliseconds for normal calls (trigger calls use 3x this).
VITE_HTTP_TIMEOUT_MS=20000

# ---- Auth ----
# Auth mechanism. Currently only "jwt" is implemented; kept configurable so it can be swapped.
VITE_AUTH_MODE=jwt
# Where to persist the JWT: "local" (localStorage) or "memory" (cleared on refresh).
VITE_AUTH_STORAGE=local

# ---- Mocks ----
# When "true", MSW intercepts all API calls with in-memory fixtures. No backend required.
VITE_USE_MOCKS=true

# ---- Sync ----
# When "true", the app calls POST /workflows/sync once on startup.
VITE_AUTO_SYNC_ON_START=false
